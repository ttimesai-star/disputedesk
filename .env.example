# --- PayPal (leave empty to run on the built-in mock that follows the official API schemas) ---
# Sandbox app credentials from https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook ID of the sandbox webhook subscribed to CUSTOMER.DISPUTE.* (used to verify signatures)
PAYPAL_WEBHOOK_ID=
# Only "sandbox" is supported. Live mode is refused on purpose.
PAYPAL_ENV=sandbox

# --- LLM (any OpenAI-compatible endpoint; both have free tiers). Leave empty -> rule-based drafts ---
# Primary: Google Gemini (OpenAI-compatible endpoint)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Fallback: Groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Server ---
PORT=8787
# Directory for the action journal and policies (JSON). Defaults to ./data
DATA_DIR=
